#!/data/data/com.offsec.nhterm/files/usr/bin_aarch64/bash
# Version: 1.0.4

# export path for android bins/tools
export PATH="/data/data/com.offsec.nethunter/files/scripts:/data/data/com.offsec.nethunter/files/scripts/bin:/data/data/com.offsec.nhterm/files/home/.nhterm/script:/data/data/com.offsec.nhterm/files/usr/bin_aarch64:/data/data/com.offsec.nhterm/files/usr/sbin:/sbin:/system/bin:/system/xbin:/apex/com.android.runtime/bin:/apex/com.android.art/bin:/odm/bin:/vendor/bin:/product/bin:."
# Remove some exports that break default android binaries from running
unset LD_LIBRARY_PATH
unset LD_PRELOAD
export PS1="\[\e[1;32m\]\u [ \[\e[0m\]\w\[\e[1;32m\] ]$ \[\e[0m\]"

##
# Find and identify su solution
# As different solutions have and use different args :(
##

SU1=$(which su)

M_SU="$SU1 -i -mm -s $*"
K_SU="$SU1 -M -p -s $*"
U_SU="$SU1 $*"

# try obvious flags first
for f in --version -v -V --help; do
  o="$("$SU1" $f 2>/dev/null || true)"
  case "$o" in
    *MagiskSU* ) export SU2="${M_SU}";;
    *SuperSU*|*superuser*|*Chainfire* ) export SU2="${U_SU}";;
    *busybox* ) export SU2="${U_SU}";;
    *toybox* ) export SU2="${U_SU}";;
    *KernelSU* ) export SU2="${K_SU}";;
  esac
done

##
# Finally do the main script job
##

# clear out old view
clear

$SU2 /data/data/com.offsec.nhterm/files/usr/bin_aarch64/bash
